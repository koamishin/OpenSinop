# =============================================================================
# Application Configuration
# =============================================================================
# Your application name (used in emails, notifications, etc.)
APP_NAME=Laravel

# Environment: local, staging, production
APP_ENV=local

# Application key (auto-generated via: php artisan key:generate)
APP_KEY=

# Enable debug mode (MUST be false in production)
APP_DEBUG=true

# Your application URL (used for asset generation, emails, etc.)
APP_URL=http://localhost

# Memory ceiling for the application container (Docker deployments only).
# The shipped php.ini sets memory_limit = -1 so an attacker cannot trigger the
# CVE-2026-109618 out-of-memory condition on demand; this limit is what keeps
# a runaway request from taking down the host.
APP_MEMORY_LIMIT=2g

# =============================================================================
# Localization
# =============================================================================
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =============================================================================
# Maintenance Mode
# =============================================================================
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# =============================================================================
# Performance & Security
# =============================================================================
# Number of PHP workers (uncomment for production)
# PHP_CLI_SERVER_WORKERS=4

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# Logging
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Database Configuration
# =============================================================================
# Default: SQLite (easiest for development)
# For MySQL/PostgreSQL, uncomment and configure the options below
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================================
# Session & Cache
# =============================================================================
# Session driver: file, cookie, database, redis, memcached
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache driver: file, database, redis, memcached
CACHE_STORE=database
# CACHE_PREFIX=

# =============================================================================
# Queue & Broadcasting
# =============================================================================
# Queue connection: sync, database, redis, sqs
QUEUE_CONNECTION=database

# Broadcasting: log, pusher, redis, ably
BROADCAST_CONNECTION=log

# =============================================================================
# File Storage
# =============================================================================
# Filesystem disk: local, public, s3
FILESYSTEM_DISK=local

# =============================================================================
# External Services
# =============================================================================
# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis (for caching, queues, or sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# Mail Configuration
# =============================================================================
# Mail driver: smtp, sendmail, mailgun, ses, postmark, log
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS Services (S3, SES, etc.)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Frontend (Vite)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Lepton Agents (Circle + Arc)
# =============================================================================
# Driver selection:
#   fake      = In-memory simulated ledger (no CLI, credentials, or funds needed; safe for demos/testing)
#   circle    = Live onchain rail using Circle Agent Stack CLI & Arc network (requires Circle CLI & MPC wallet)
#   developer = Pure HTTP REST API using Circle Developer-Controlled Wallets (no CLI needed)
LEPTON_DRIVER=circle
LEPTON_CIRCLE_BIN=circle
LEPTON_ARC_BIN=arc-canteen
LEPTON_CHAIN=ARC-TESTNET
LEPTON_CHAIN_ID=5042002
LEPTON_TREASURY_ADDRESS=
LEPTON_RPC_URL=
LEPTON_DRY_RUN=false

# Student-owned wallets: Arc Testnet 5042002 only, independent of operator signing.
STUDENT_CONTROLLED_WALLETS_ENABLED=false
# Circle Console User-Controlled Wallets credentials (testnet key, never VITE_).
CIRCLE_USER_WALLETS_API_KEY=
CIRCLE_USER_WALLETS_APP_ID=
CIRCLE_WALLETS_GOOGLE_CLIENT_ID=
CIRCLE_WALLETS_FACEBOOK_APP_ID=

# Circle Developer-Controlled Wallets REST API (used when LEPTON_DRIVER=developer or circle-rest)
LEPTON_CIRCLE_API_KEY=
LEPTON_ENTITY_SECRET=
LEPTON_WALLET_SET_ID=
LEPTON_CIRCLE_API_URL=https://api.circle.com/v1/w3s

# --- Verified Circle notifications (opt-in) ------------------------------------
# POST /api/webhooks/circle answers 404 unless BOTH of the following are true:
#   - LEPTON_WEBHOOKS_ENABLED=true
#   - LEPTON_DRIVER is developer or circle-rest
# A verified event is stored once (unique notificationId + payload digest) and
# only queues observation. It never creates or submits a payment and never
# settles one; the response is 202 with "settlement_verified": false.
LEPTON_WEBHOOKS_ENABLED=false
# Comma-separated subscription IDs this deployment is allowed to accept.
LEPTON_WEBHOOK_SUBSCRIPTIONS=
# Acceptance window for a signed timestamp. Size it for your redelivery policy:
# a stale but genuine event needs recovery, not relaxed signature checks.
LEPTON_WEBHOOK_MAX_AGE_SECONDS=86400

# --- Student tuition pilot (all four default OFF) -------------------------------
# These are operator decisions, not application defaults. Nothing below moves
# money or creates a Collections receipt until an operator sets it.
#
# EDUFLOW_TUITION_SUBMISSION_ENABLED=false   # sign new consented transfers
# EDUFLOW_TUITION_OBSERVATION_ENABLED=false   # resolve accepted transfers on chain
# EDUFLOW_TUITION_SUBMISSION_STOP=false       # stops new submissions, keeps recovery
# EDUFLOW_TUITION_AUTO_INTAKE=false           # reconcile settled movements unattended
#
# Signing additionally requires a rail that can ENFORCE the accepted sender-fee
# ceiling. The installed `circle wallet transfer` exposes no such cap, so with
# LEPTON_DRIVER=circle submission refuses before invoking the signer rather than
# sending an unbounded fee. An estimate is not a spending limit.
#
# EDUFLOW_TUITION_INTAKE_OWNER_ID=            # verified finance account credited as receipt maker; must not be a payer
# EDUFLOW_TUITION_QUEUE_CONNECTION=database
EDUFLOW_TUITION_SUBMISSION_ENABLED=false
EDUFLOW_TUITION_OBSERVATION_ENABLED=false
EDUFLOW_TUITION_SUBMISSION_STOP=false
EDUFLOW_TUITION_AUTO_INTAKE=false
EDUFLOW_TUITION_QUEUE_CONNECTION=database

# --- Laravel AI SDK (optional) -------------------------------------------------
# OpenSinop runs without any of these. Every model call is fail-closed, so a
# missing key or an unreachable endpoint degrades to the deterministic policy
# engine rather than blocking a payment.
#
# Default provider. `local` or `openai-compatible` endpoint configured for
# an OpenAI-compatible API gateway (e.g. Ollama, vLLM, LiteLLM, or custom proxy).
AI_PROVIDER=local
AI_LOCAL_URL=http://localhost:11434/v1
AI_LOCAL_MODEL=ag/gemini-3.8-flash-high
# AI_LOCAL_API_KEY=

OPENAI_COMPATIBLE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_MODEL=ag/gemini-3.8-flash-high
OPENAI_COMPATIBLE_API_KEY=

# For a hosted model, set AI_PROVIDER=openai or anthropic and the matching key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Institution policy evaluation & background AI agent
EDUFLOW_INSTITUTION_POLICY_ADVICE=true
EDUFLOW_POLICY_CLASSIFICATION_ENGINE=jev
